{
  // Cloudflare Worker config for quotasaleshq.com
  "name": "quota",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-23",
  // Custom domains: Cloudflare attaches these to this Worker on every deploy
  "routes": [
    { "pattern": "quotasaleshq.com", "custom_domain": true },
    { "pattern": "www.quotasaleshq.com", "custom_domain": true }
  ],
  // Lets the Worker email applications through Cloudflare Email Routing.
  // quotasaleshq@gmail.com must be a Verified destination address in Email Routing.
  "send_email": [
    { "name": "SEND_EMAIL", "destination_address": "quotasaleshq@gmail.com" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run the Worker first for /api/* and for www so redirects work
    "run_worker_first": true
  }
}
