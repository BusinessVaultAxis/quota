{
  // Cloudflare Worker config for quotasaleshq.com
  "name": "quota",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run the Worker first for /api/* and for www so redirects work
    "run_worker_first": true
  }
}
